# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. on Render)
APP_URL="https://farmiq-z14k.onrender.com"

# ==============================================================================
# CLOUD DATABASE PERSISTENCE FOR RENDER (Solves Render data loss issue)
# ==============================================================================
# Render web services have ephemeral disks. When Render restarts or sleeps,
# files in data/ are reset to the Git repo state.
#
# Set ONE of the following environment variables in your Render Dashboard:
#
# 1. OPTION 1 (Recommended): MongoDB Atlas (100% Free M0 Cluster, 512MB)
#    Create a free account at https://www.mongodb.com/cloud/atlas
#    Whitelist IP 0.0.0.0/0 in Network Access.
#    Copy your connection string and paste below:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/farmiq?retryWrites=true&w=majority"
#
# 2. OPTION 2: PostgreSQL (Supabase / Neon / Render Managed PostgreSQL)
#    DATABASE_URL="postgres://postgres:<password>@<host>:5432/<database>?sslmode=require"
#
# If neither is set, FarmiQ automatically falls back to local ./data/app_state.json.
# ==============================================================================
