# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://farmiq-z14k.onrender.com)
APP_URL="https://farmiq-z14k.onrender.com"

# ==============================================================================
# CLOUD DATABASE PERSISTENCE (Solves Render ephemeral data reset)
# ==============================================================================
# Render web services have ephemeral storage. When the instance restarts,
# local filesystem resets. Adding a cloud DB permanently stores all users & data.
#
# Option 1 (Recommended for Render): Render Managed PostgreSQL / Supabase / Neon
# DATABASE_URL="postgres://username:password@hostname:5432/farmiq?sslmode=require"
# Note: When deploying with render.yaml Blueprint, Render auto-provisions this!
#
# Option 2: MongoDB Atlas (Free M0 cluster 512MB)
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/farmiq?retryWrites=true&w=majority"
#
# If neither is provided, FarmiQ runs seamlessly on local ./data/app_state.json.
# ==============================================================================

